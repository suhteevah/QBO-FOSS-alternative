# ── OpenLedger Configuration ──────────────────────────────────
# Copy this file to .env and fill in your values
# The install scripts will generate this automatically

# Database — choose ONE option:
#
# Option A: PostgreSQL (production)
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/openledger
# DATABASE_URL_SYNC=postgresql://user:pass@localhost:5432/openledger
#
# Option B: SQLite (dev/demo — no PostgreSQL needed)
DATABASE_URL=sqlite+aiosqlite:///./openledger.db
DATABASE_URL_SYNC=sqlite:///./openledger.db

# Security — CHANGE THIS in production!
SECRET_KEY=change-me-in-production

# AI (optional — leave empty to disable AI features)
ANTHROPIC_API_KEY=
SONNET_MODEL=claude-sonnet-4-20250514

# OCR
OCR_ENGINE=tesseract

# Accounting
ACCOUNTING_BASIS=accrual
DEFAULT_FISCAL_YEAR_START=1

# API Keys (optional — leave empty for no default expiry)
# API_KEY_DEFAULT_EXPIRY_DAYS=365

# Debug mode (set to false in production)
DEBUG=true
